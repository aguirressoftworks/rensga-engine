      ]
    },
    "windows-x86_64": {
      "status": "available",
      "parts": [
        {"url": "https://github.com/mstorsjo/llvm-mingw/releases/download/20261020/llvm-mingw-20261020-ucrt-x86_64.zip", "sha256": "fd5462b7f5d93b2ff981fcd3f9c7e427e47f3203c64ea91c27bcc444eebd74cd", "size": 190612575, "archive": "zip", "strip": 1},
        {"url": "https://github.com/libsdl-org/SDL/releases/download/release-2.30.8/SDL2-devel-2.30.8-mingw.tar.gz", "sha256": "adbf5ae7b5144f02d4cb091a9a7f4752f8e835b4bebd9f3fcafd9d7a4194f3b9", "size": 7428428, "archive": "tar.gz", "strip": 1, "dest": "sdl2"}

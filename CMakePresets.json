{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "linux-host",
      "displayName": "Linux host: tests, cooker, pipeline, CLI, editor, headless runtime",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "RENSGA_TARGET": "linux-host",
        "RENSGA_BUILD_TESTS": "ON",
        "RENSGA_BUILD_TOOLS": "ON",
        "RENSGA_BUILD_EDITOR": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "psp",
      "displayName": "PSP: runtime ELF, run inside the pspdev Docker image (tools/docker/psp.sh)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "toolchainFile": "$env{PSPDEV}/psp/share/pspdev.cmake",
      "cacheVariables": {
        "RENSGA_TARGET": "psp",
        "RENSGA_BUILD_TESTS": "OFF",
        "RENSGA_BUILD_TOOLS": "OFF",
        "RENSGA_BUILD_EDITOR": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x64 cross-build: llvm-mingw + SDL2 from the windows-build module (or MinGW-w64 in tools/docker/windows.sh)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "toolchainFile": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
      "cacheVariables": { "RENSGA_TARGET": "windows", "RENSGA_BUILD_TESTS": "OFF", "RENSGA_BUILD_TOOLS": "OFF", "RENSGA_BUILD_EDITOR": "OFF", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "android",
      "displayName": "Android arm64: NDK + SDL2 libmain.so; the APK comes from tools/android (Gradle) with the android-build module (tools/ci/android.sh)",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": { "RENSGA_TARGET": "android", "ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-24", "RENSGA_BUILD_TESTS": "OFF", "RENSGA_BUILD_TOOLS": "OFF", "RENSGA_BUILD_EDITOR": "OFF", "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ps2",
      "displayName": "PS2: EE ELF with gsKit, run inside tools/docker/ps2.sh",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "toolchainFile": "$env{PS2SDK}/ps2dev.cmake",
      "cacheVariables": { "RENSGA_TARGET": "ps2", "RENSGA_BUILD_TESTS": "OFF", "RENSGA_BUILD_TOOLS": "OFF", "RENSGA_BUILD_EDITOR": "OFF", "CMAKE_BUILD_TYPE": "Release" }
    },
    { "name": "psx", "displayName": "PSX (slot for F1 and later)", "inherits": "base", "hidden": true, "cacheVariables": { "RENSGA_TARGET": "psx" } }
  ],
  "buildPresets": [
    { "name": "linux-host", "configurePreset": "linux-host" },
    { "name": "psp", "configurePreset": "psp" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "android", "configurePreset": "android" },
    { "name": "ps2", "configurePreset": "ps2" }
  ],
  "testPresets": [
    { "name": "linux-host", "configurePreset": "linux-host", "output": { "outputOnFailure": true } }
  ]
}

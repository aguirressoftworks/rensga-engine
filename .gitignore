# build output and caches
build/
out/
Library/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json
.cache/
# emulator binaries (VERSION, LICENSE, SOURCE are committed)
third_party/emulators/ppsspp/*
!third_party/emulators/ppsspp/VERSION
!third_party/emulators/ppsspp/LICENSE
!third_party/emulators/ppsspp/SOURCE
# editor layout
imgui.ini
*.log
# local tooling
.claude/settings.local.json
tools/android/local.properties
tools/android/.gradle/
tools/android/app/.cxx/
# console BIOS dumps and PCSX2 sandboxes: never commit (RULES.md section 5)
*.erom
*.nvm
*.mec
*.rom
**/bios/
pcsx2-sandbox/

# platform/emulator sandboxes (local only; never commit BIOS or emulator configs)
build/pcsx2/
*.bios
